{
  "name": "onefi-emi-store",
  "version": "2.0.0",
  "private": true,
  "description": "MERN storefront for mutual-fund backed EMI plans (1Fi SDE1 assignment)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "seed": "npm run seed --workspace server",
    "images:generate": "node scripts/generate-images.mjs"
  },
  "devDependencies": {
    "concurrently": "10.0.5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
