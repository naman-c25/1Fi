# ---------------------------------------------------------------------------
# MongoDB connection.
#
# Local (what this project was developed against):
#   MONGODB_URI="mongodb://127.0.0.1:27017/onefi"
#
# MongoDB Atlas (needed for a deployed demo — a local mongod is not reachable
# from Render/Vercel):
#   MONGODB_URI="mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/onefi?retryWrites=true&w=majority"
#
# NOTE the "/onefi" before the "?". The connection string Atlas shows you in the
# Connect dialog ends in ".mongodb.net/?appName=Cluster0" with NO database name,
# and Mongo then silently uses a database called "test" — so the API connects
# fine and serves an empty catalogue. The server falls back to "onefi" and logs
# a warning when the name is missing, but it is better to be explicit.
# ---------------------------------------------------------------------------
MONGODB_URI="mongodb://127.0.0.1:27017/onefi"

PORT=4000

# Comma-separated origins allowed to call this API from a browser.
# The deployed client's URL goes here.
CORS_ORIGIN="http://localhost:5173"
