# ---------------------------------------------------------------------------
# MongoDB connection.
#
# Local (what this project was developed against):
#   MONGODB_URI="mongodb://127.0.0.1:27017/onefi"
#
# MongoDB Atlas (needed for a deployed demo — a local mongod is not reachable
# from Render/Vercel):
#   MONGODB_URI="mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/onefi?retryWrites=true&w=majority"
# ---------------------------------------------------------------------------
MONGODB_URI="mongodb://127.0.0.1:27017/onefi"

PORT=4000

# Comma-separated origins allowed to call this API from a browser.
# The deployed client's URL goes here.
CORS_ORIGIN="http://localhost:5173"
