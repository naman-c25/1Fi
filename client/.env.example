# Base URL of the Express API.
#
# Leave EMPTY for local development: Vite proxies /api to http://localhost:4000
# (see client/vite.config.js), so the browser talks to its own origin and there
# is no CORS involved.
#
# For a deployed client, point this at the deployed API, e.g.
#   VITE_API_URL="https://onefi-emi-api.onrender.com"
VITE_API_URL=""
