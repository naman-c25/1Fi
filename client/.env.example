# Base URL of the Express API.
#
# Leave EMPTY (the default) and every call is same-origin:
#   - development: Vite proxies /api to http://localhost:4000 (vite.config.js)
#   - production:  client/vercel.json rewrites /api/* to the deployed API
# Nothing is cross-origin, so CORS never comes into it.
#
# Set it only if you want the browser to call the API on its own origin, e.g.
#   VITE_API_URL="https://server-lac-seven-91.vercel.app"
# in which case CORS_ORIGIN on the server must name this client's URL.
VITE_API_URL=""
