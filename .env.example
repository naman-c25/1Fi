# ---------------------------------------------------------------------------
# PostgreSQL connection.
# Works with any Postgres (Neon, Supabase, Railway, RDS, local docker...).
#
# Local example:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/onefi?schema=public"
#   DIRECT_URL="postgresql://postgres:postgres@localhost:5432/onefi?schema=public"
#
# Neon example (DATABASE_URL uses the -pooler host, DIRECT_URL does not):
#   DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/onefi?sslmode=require"
#   DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/onefi?sslmode=require"
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/onefi?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/onefi?schema=public"
